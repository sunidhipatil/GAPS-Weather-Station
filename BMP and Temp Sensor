#include <DHT.h>

#define DHTPIN A3        // Pin where DHT sensor is connected
#define DHTTYPE DHT11    // Change to DHT22 if using a DHT22 sensor

DHT dht(DHTPIN, DHTTYPE);

void setup() {
    Serial.begin(9600);  // Initialize Serial Monitor
    Serial.println("Starting DHT Sensor Test...");
    dht.begin();
}

void loop() {
    float h = dht.readHumidity();
    float t = dht.readTemperature();

    if (isnan(h) || isnan(t)) {
        Serial.println("Failed to read from DHT sensor! Check wiring.");
    } else {
        Serial.print("Humidity: ");
        Serial.print(h);
        Serial.print("%, Temperature: ");
        Serial.print(t);
        Serial.println("°C");
    }

    delay(2000); // Wait 2 seconds before next reading
}

